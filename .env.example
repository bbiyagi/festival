# 서버 전용 (VITE_ 접두사 금지). 공공데이터포털 Decoding 키
TOURAPI_SERVICE_KEY=your-tourapi-decoding-key
# 브라우저용 네이버 지도 Client ID (ncpKeyId)
VITE_NAVER_MAP_CLIENT_ID=your-naver-map-client-id

# Supabase: URL과 publishable 키는 브라우저용(RLS로 보호)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# 서버 전용 secret 키 (RLS 우회). 알림·캘린더 예약 작업에서만 쓴다. 절대 VITE_ 금지
SUPABASE_SECRET_KEY=sb_secret_xxx
